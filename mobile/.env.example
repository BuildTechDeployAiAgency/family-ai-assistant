# Template — copy to mobile/.env (gitignored). Expo inlines EXPO_PUBLIC_* into the
# app bundle, so ONLY browser-safe public values belong here. The AI key is NOT
# here — it lives server-side in the Vercel api/ functions.

EXPO_PUBLIC_SUPABASE_URL=https://lldbxyadiprsgtftduhe.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   # publishable/anon key (safe to ship)

# Base URL of the deployed api/ functions (Vercel). For local dev use your
# machine's LAN IP so the phone can reach `vercel dev`, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://<your-vercel-deployment>.vercel.app
