# Template — copy to .env (gitignored) and fill in real values. Required at boot per envalid (lib/env.js).

# Supabase (D-06, D-11)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ... (anon public key from dashboard)
SUPABASE_SERVICE_ROLE_KEY=eyJ... (SECRET — server-side only, never VITE_-prefixed)

# OpenRouter (D-15, server-side only)
OPENROUTER_API_KEY=sk-or-v1-...

# Upstash Redis for @upstash/ratelimit (D-15)
UPSTASH_REDIS_REST_URL=https://<region>-<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Frontend Supabase client needs only the anon key (browser-safe). Vite reads VITE_*.
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# Deferred to later phases:
# GOOGLE_CLIENT_SECRET=...      (Phase 3 — Drive OAuth)
# TELEGRAM_BOT_TOKEN=...        (Phase 4 — Telegram bot)
