# Template — copy to .env (gitignored) and fill in real values.
# Validated at boot by api/_lib/env.ts (envalid, fail-fast).
# These are SERVER-ONLY secrets for the Vercel api/ functions. NEVER prefix with
# VITE_ or EXPO_PUBLIC_ — that would ship them to the client bundle.

# Supabase
SUPABASE_URL=https://lldbxyadiprsgtftduhe.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...        # publishable/anon key (RLS path uses the user's JWT)
SUPABASE_SERVICE_ROLE_KEY=                  # SECRET — leave blank for MVP; needed only for Phase 3 ingestion

# OpenRouter (server-side only — the AI key never reaches the client)
OPENROUTER_API_KEY=sk-or-v1-...             # ROTATED key (the old VITE_-bundled one is revoked)
OPENROUTER_MODEL_AGENT=openai/gpt-4o-mini   # must support tool-calling; verify before locking
OPENROUTER_MODEL_EXTRACT=openai/gpt-4o-mini # cheap, supports vision + json mode

# Upstash Redis — optional in dev (rate-limit + cost-cap become no-ops if blank)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# POC determinism + cost guardrail
REFERENCE_DATE=2026-05-19
DAILY_COST_CAP_USD=2

# Deferred to later phases:
# TELEGRAM_BOT_TOKEN=...        (Phase 3 — Telegram bot)
# TELEGRAM_WEBHOOK_SECRET=...   (Phase 3 — webhook verification)
