# Express server port
PORT=5000

# REQUIRED in production — JWT signing secret (the in-source fallback is dev-only)
JWT_SECRET=change-me-to-a-long-random-string

# Server-side OpenRouter key for /api/ai/* endpoints (document scan, email
# analysis, agent chat, recipe extraction). Without it those endpoints
# return 503 and the mobile app falls back to demo extraction.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model slug
# OPENROUTER_MODEL=google/gemini-2.5-flash
